{
  "name": "pi-llama-cpp",
  "version": "0.9.1",
  "description": "Supercharges Pi's built-in llama.cpp provider with per-model thinking levels and sampling parameter sets.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "llama-cpp"
  ],
  "author": "Gabriel Sanhueza",
  "contributors": [
    {
      "name": "Gabriel Sanhueza",
      "url": "https://github.com/gsanhueza"
    },
    {
      "name": "Gregoo",
      "url": "https://github.com/gregoo"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregoo/pi-llama-cpp.git"
  },
  "homepage": "https://github.com/gregoo/pi-llama-cpp#readme",
  "bugs": {
    "url": "https://github.com/gregoo/pi-llama-cpp/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "prettier": {
    "printWidth": 80,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "vitest": "^4.1.10"
  }
}
